# =============================================================================
# REPUTATION RISK INTELLIGENCE MVP - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# For Railway.app: Add these as environment variables in the Railway dashboard

# -----------------------------------------------------------------------------
# Twitter/X API Credentials (Required for live monitoring)
# -----------------------------------------------------------------------------
# Get these from https://developer.twitter.com/en/portal/dashboard
# Note: You need "Basic" or higher tier for search API access
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# -----------------------------------------------------------------------------
# LLM Provider (Required - Choose one)
# -----------------------------------------------------------------------------
# Option 1: OpenAI (recommended: gpt-4-turbo-preview or gpt-4o)
OPENAI_API_KEY=your_openai_api_key

# Option 2: Anthropic Claude (recommended: claude-3-opus or claude-3-sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key

# LLM Configuration
LLM_PROVIDER=openai  # Options: 'openai' or 'anthropic'
LLM_MODEL=gpt-4-turbo-preview  # or 'claude-3-opus-20240229', 'claude-3-sonnet-20240229'

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
DEBUG=false
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Railway.app Deployment Notes
# -----------------------------------------------------------------------------
# 1. Create a new project on Railway.app
# 2. Connect your GitHub repository
# 3. Add the environment variables above in Railway dashboard:
#    - Go to your service → Variables tab
#    - Add each variable (don't include comments)
# 4. Railway will auto-detect Python and deploy
# 5. Your app will be available at: https://your-app.up.railway.app
#
# Required variables for deployment:
# - TWITTER_BEARER_TOKEN (minimum for Twitter API)
# - OPENAI_API_KEY or ANTHROPIC_API_KEY (for AI agents)
# - LLM_PROVIDER (set to 'openai' or 'anthropic')
#
# The PORT variable is automatically set by Railway - don't set it manually
